# Claude credentials (any one). Without them the console runs in demo mode.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=          # gateway, as VOLT supports

# VOLT_MODEL=claude-opus-5-5
# VOLT_ORCHESTRATOR_EFFORT=high   # low | medium | high | xhigh | max
# VOLT_SPECIALIST_EFFORT=medium
# VOLT_FALLBACKS=on               # server-side refusal fallback; set off for gateways/Bedrock/Vertex
# VOLT_MODE=                      # force "live" or "demo"
# VOLT_DATA_DIR=./data            # where volt-catalog.json / volt-skills.json.gz live
# PORT=8787
